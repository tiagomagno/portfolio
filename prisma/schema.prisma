generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Case do portfólio (dados básicos + narrativa completa de case study), criado e editado
/// via /admin/cases. Substitui os itens hardcoded que existiam em src/data/portfolio.ts —
/// esse arquivo agora só guarda tipos/helpers puros (slugify, categorias etc).
model Case {
  id             String    @id @default(cuid())
  slug           String    @unique
  empresa        String
  /// AtuacaoCategory[]
  atuacao        Json
  /// string[]
  produtos       Json
  coverImage     String?   @db.Text
  heroImage      String?   @db.Text
  /// Cor sólida alternativa ao heroImage no banner de topo. Mutuamente exclusiva com heroImage.
  heroColor      String?
  /// { url: string, active: boolean }[]
  gallery        Json?
  role           String?
  year           String?
  heroSubtitle   String?   @db.Text
  /// { context, businessProblem, goals: string[], roleScope, constraints: string[] }
  overview       Json?
  /// { methodology, whyThisApproach, insight, stakeholderManagement }
  diagnosis      Json?
  /// { hypothesis, discardedAlternatives: {title,reason}[], edgeCases, designSystem, usabilityValidation }
  design         Json?
  /// { engineeringCollaboration, specDocumentation, launchStrategy }
  handoff        Json?
  /// { metrics: {value,label}[], qualitativeImpact, postMortem }
  impact         Json?
  /// Selecionado para aparecer no carrossel de Cases da home (o admin escolhe até 10).
  featuredOnHome Boolean   @default(false)
  /// Posição entre os cases selecionados pra home (menor = aparece primeiro no carrossel).
  /// Só é relevante quando featuredOnHome = true; ignorado nos demais.
  homeOrder      Int       @default(0)
  visible        Boolean   @default(true)
  /// Soft-delete: tira o case da lista principal do admin, mantendo a opção de restaurar.
  removedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// LEGADO — substituído pelo model Case (imagens/categorias agora vivem direto na linha do
/// case). Mantido sem uso pra não ser uma migration destrutiva; candidato a remoção futura
/// com autorização explícita.
/// Sobrepõe as imagens (capa/topo/galeria) e as categorias de um case do portfólio,
/// geridas pelo admin. O texto do case continua vindo de src/data/portfolio.ts.
model CaseAsset {
  id         String   @id @default(cuid())
  slug       String   @unique
  coverImage String?  @db.Text
  heroImage  String?  @db.Text
  /// Cor sólida alternativa ao heroImage no banner de topo do case. Mutuamente exclusiva
  /// com heroImage — o admin (/admin/cases) sempre limpa uma ao definir a outra.
  heroColor  String?
  gallery    Json?
  /// Categorias (AtuacaoCategory[]) que sobrescrevem as fixas em src/data/portfolio.ts.
  /// null = sem override, usa as categorias estáticas do case.
  atuacao    Json?
  /// Selecionado para aparecer no carrossel de Cases da home (o admin escolhe até 10;
  /// a ordem de exibição continua embaralhada no client, então não há campo de ordem).
  /// Nenhum item marcado = comportamento antigo (mostra todos os cases com case study).
  featuredOnHome Boolean @default(false)
  updatedAt  DateTime @updatedAt
}

/// LEGADO — substituído pelo model Case (visible/removedAt agora vivem direto na linha do
/// case). Mantido sem uso pra não ser uma migration destrutiva; candidato a remoção futura
/// com autorização explícita.
/// Visibilidade de um case do portfólio no site (a lista completa e o texto continuam
/// fixos em src/data/portfolio.ts — não é possível remover a entrada de lá em runtime,
/// então isso controla apenas se ele aparece ou não). Sem uma linha aqui para um slug,
/// o case é exibido normalmente. "Desativado" e "excluído" têm o mesmo efeito no site
/// (não aparece); removedAt só serve para tirar o case da lista principal do admin,
/// mantendo a opção de restaurar.
model PortfolioItemVisibility {
  slug      String    @id
  visible   Boolean   @default(true)
  removedAt DateTime?
  updatedAt DateTime  @updatedAt
}

/// Configurações globais do site (marca, contato, redes sociais, destinatários de
/// formulário) — linha única (id fixo "global"), editada em /admin/global. Sem linha
/// (banco fora do ar / antes do primeiro save), getSiteSettings() cai nos mesmos valores
/// destes defaults, então o site nunca fica sem marca/contato.
model SiteSettings {
  id                        String   @id @default("global")
  brandName                 String   @default("Tiago Magno")
  contactEmail               String  @default("tiagosilvamagno@gmail.com")
  /// Só dígitos (com DDI/DDD), usado pra montar o link wa.me.
  whatsappNumber              String @default("5592981168163")
  linkedinUrl                 String @default("https://www.linkedin.com/in/tiagosmagno/")
  /// Destinatário do formulário de Contato da home (FormSubmit).
  contactFormRecipientEmail   String @default("tiagosilvamagno@gmail.com")
  /// Destinatário do formulário de Briefing (FormSubmit).
  briefingFormRecipientEmail  String @default("tiagosilvamagno@gmail.com")
  updatedAt                   DateTime @updatedAt
}

model Lead {
  id         String    @id @default(cuid())
  source     String
  status     String    @default("novo")
  name       String
  email      String
  data       Json
  createdAt  DateTime  @default(now())
  /// Arquivado: some do board padrão em /admin/leads, mas continua no banco (reversível).
  /// Excluir de fato é um DELETE — sem campo aqui, é permanente.
  archivedAt DateTime?
}

/// Item do menu de navegação do header. Seedado a partir da lista fixa que existia em Header.tsx.
model MenuItem {
  id      String  @id @default(cuid())
  labelPt String
  labelEn String
  href    String
  order   Int     @default(0)
  visible Boolean @default(true)
}

/// Ordem/visibilidade das seções da home (Hero, Sobre, Cases...). O componente de cada
/// seção continua fixo no código — isso só controla ordem e se aparece ou não.
model HomeSection {
  key     String  @id
  label   String
  order   Int     @default(0)
  visible Boolean @default(true)
}

/// Sobrepõe um texto (chave de src/lib/translations.ts) nos dois idiomas. Sem uma linha
/// aqui para a chave, o site usa o valor estático de translations.ts normalmente.
model PageContent {
  key       String   @id
  valuePt   String   @db.Text
  valueEn   String   @db.Text
  updatedAt DateTime @updatedAt
}

/// SEO (título, descrição, palavras-chave, imagem de compartilhamento, URL canônica e
/// indexação) de uma página fixa do site ('home' | 'portfolio' | 'briefing' | 'consultoria'),
/// editável em /admin/pages/<página>. Sem uma linha aqui, a página usa os defaults do
/// `generateMetadata` no código.
/// O <html lang> do site é sempre pt-BR no servidor (a troca de idioma é só client-side), então
/// o título/descrição/keywords em EN não chegam a aparecer no <head> renderizado — servem só
/// de referência/rascunho até o site ganhar rotas por idioma.
model SeoMeta {
  page          String   @id
  titlePt       String?
  titleEn       String?
  descriptionPt String?  @db.Text
  descriptionEn String?  @db.Text
  keywordsPt    String?  @db.Text
  keywordsEn    String?  @db.Text
  ogImage       String?  @db.Text
  canonicalUrl  String?
  noIndex       Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

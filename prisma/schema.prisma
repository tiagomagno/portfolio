generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Sobrepõe as imagens (capa/topo/galeria) de um case do portfólio, gerenciadas pelo admin.
/// O texto do case continua vindo de src/data/portfolio.ts — aqui só ficam as imagens.
model CaseAsset {
  id         String   @id @default(cuid())
  slug       String   @unique
  coverImage String?  @db.Text
  heroImage  String?  @db.Text
  /// Cor sólida alternativa ao heroImage no banner de topo do case. Mutuamente exclusiva
  /// com heroImage — o admin (/admin/cases) sempre limpa uma ao definir a outra.
  heroColor  String?
  gallery    Json?
  updatedAt  DateTime @updatedAt
}

model Lead {
  id        String   @id @default(cuid())
  source    String
  status    String   @default("novo")
  name      String
  email     String
  data      Json
  createdAt DateTime @default(now())
}

/// Item do menu de navegação do header. Seedado a partir da lista fixa que existia em Header.tsx.
model MenuItem {
  id      String  @id @default(cuid())
  labelPt String
  labelEn String
  href    String
  order   Int     @default(0)
  visible Boolean @default(true)
}

/// Ordem/visibilidade das seções da home (Hero, Sobre, Cases...). O componente de cada
/// seção continua fixo no código — isso só controla ordem e se aparece ou não.
model HomeSection {
  key     String  @id
  label   String
  order   Int     @default(0)
  visible Boolean @default(true)
}

/// Sobrepõe um texto (chave de src/lib/translations.ts) nos dois idiomas. Sem uma linha
/// aqui para a chave, o site usa o valor estático de translations.ts normalmente.
model PageContent {
  key       String   @id
  valuePt   String   @db.Text
  valueEn   String   @db.Text
  updatedAt DateTime @updatedAt
}

/// SEO (título, descrição, palavras-chave, imagem de compartilhamento, URL canônica e
/// indexação) de uma página fixa do site ('home' | 'portfolio' | 'briefing'), editável em
/// /admin/textos. Sem uma linha aqui, a página usa os defaults do `generateMetadata` no código.
/// O <html lang> do site é sempre pt-BR no servidor (a troca de idioma é só client-side), então
/// o título/descrição/keywords em EN não chegam a aparecer no <head> renderizado — servem só
/// de referência/rascunho até o site ganhar rotas por idioma.
model SeoMeta {
  page          String   @id
  titlePt       String?
  titleEn       String?
  descriptionPt String?  @db.Text
  descriptionEn String?  @db.Text
  keywordsPt    String?  @db.Text
  keywordsEn    String?  @db.Text
  ogImage       String?  @db.Text
  canonicalUrl  String?
  noIndex       Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

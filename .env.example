# ── Trello (Formulário de Contato) ──
# API Key e Token são compartilhados. Gere em: https://trello.com/app-key
TRELLO_API_KEY="sua-api-key"
TRELLO_TOKEN="seu-token"

# Board "Contatos" — Formulário de contato simples. ID da lista "Novo" (abra https://trello.com/b/ID_DO_BOARD.json)
TRELLO_CONTACT_LIST_ID="id-da-lista"

# Board "Leads / Briefing" — não usado no código hoje, mantido para referência futura.
TRELLO_LEADS_LIST_ID="id-da-lista"

# ── Admin (/admin) ──
# Banco usado pelo admin para gerenciar imagens dos cases (capa/topo/galeria) e o pipeline de leads.
# Sem essa variável, o admin fica indisponível mas o site público continua funcionando normalmente
# (as páginas caem de volta pras imagens estáticas de src/data/portfolio.ts).
# Em dev local, coloque em .env (não .env.local) — o CLI do Prisma só lê .env.
# Em produção (Coolify), é só uma env var normal, não importa em qual arquivo.
DATABASE_URL="mysql://user:password@host:3306/portfolio_admin"

# Segredo usado para assinar o cookie de sessão do admin. Gere um valor aleatório longo por ambiente.
SESSION_SECRET="gere-um-valor-aleatorio-longo-por-ambiente"

# Credenciais do admin criadas automaticamente por "npm run db:seed" (só na primeira vez).
ADMIN_SEED_EMAIL="admin@tiagomagno.com.br"
ADMIN_SEED_PASSWORD="defina-uma-senha-forte"
